# Use a local container set up like this:
# https://github.com/TurbulentDynamics/TD-env-setup-dev-help/env-setup/nvidia-docker2-base-ml-container.md
FROM turbulentdynamics/td_base


#install spack (consolidated commands)
RUN git clone -c feature.manyFiles=true https://github.com/spack/spack.git --single-branch --branch releases/latest && \
    echo 'export SPACK_ROOT=~/spack'>>~/.zshrc && \
    echo 'export PATH=$SPACK_ROOT/bin:$PATH'>>~/.zshrc && \
    echo '. $SPACK_ROOT/share/spack/setup-env.sh'>>~/.zshrc

ENV SPACK_ROOT="~/spack"
ENV PATH="$SPACK_ROOT/bin:$PATH"
CMD [".", "$SPACK_ROOT/share/spack/setup-env.sh"]


# Install and configure compilers and tools with spack (updated to latest versions as of January 2025)
RUN spack install gcc@14.2.0 && \
    spack load gcc@14.2.0 && \
    spack compiler find

ENV CC=%gcc@14.2.0

# Install HPC tools with latest versions (consolidated for faster builds)
RUN spack install \
    cmake@3.31.2${CC} \
    openmpi@5.0.6${CC} \
    mpich@4.2.3${CC} \
    rust@1.84.0${CC} \
    likwid \
    htop

#Older optional versions (uncomment if needed)
#RUN spack install openmpi@4.1.6${CC} openmpi@3.1.6${CC} mpich@4.0.3${CC}
#RUN spack install gcc@13.2.0${CC} gcc@12.3.0${CC} gcc@11.4.0${CC}
#RUN spack install llvm@19.1.6${CC}

