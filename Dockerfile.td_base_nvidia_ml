# Use a local container set up like this:
# https://github.com/TurbulentDynamics/TD-env-setup-dev-help/env-setup/nvidia-docker2-base-ml-container.md
FROM td_base
#FROM turbulentdynamics/td_base

# Install python3 and pip
RUN sudo apt update && sudo apt install -y python3-pip python3-venv

# Create virtual environment for better dependency isolation
RUN python3 -m venv /home/tduser/mlenv
ENV PATH="/home/tduser/mlenv/bin:$PATH"

# Install latest Python ML packages with PyTorch (as of January 2025)
# PyTorch wheels include optimized CPU instructions (AVX2, FMA, SSE4.2) out of the box
RUN pip install --upgrade pip setuptools wheel && \
    pip install \
    torch==2.5.1 \
    torchvision==0.20.1 \
    torchaudio==2.5.1 \
    torchtext==0.18.0 \
    numpy==2.1.3 \
    pandas==2.2.3 \
    matplotlib==3.9.2 \
    scikit-learn==1.5.2 \
    scipy==1.14.1 \
    h5py==3.12.1 \
    pillow==11.0.0 \
    jupyterlab==4.3.3 \
    ipython==8.30.0 \
    seaborn==0.13.2

# Install additional ML and Deep Learning tools (latest versions)
RUN pip install \
    tensorboard==2.18.0 \
    mlflow==2.17.2 \
    optuna==4.1.0 \
    transformers==4.47.1 \
    timm==1.0.12 \
    einops==0.8.0 \
    lightning==2.4.0 \
    accelerate==1.2.1 \
    datasets==3.2.0 \
    tokenizers==0.21.0 \
    sentencepiece==0.2.0 \
    wandb==0.18.7

# References
# PyTorch wheels are optimized with AVX2, FMA, and SSE4.2 instructions
# https://pytorch.org/get-started/locally/
# For CUDA support, use pytorch.org index:
# pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu121




