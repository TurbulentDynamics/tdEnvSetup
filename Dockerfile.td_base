#Use the latest NVIDIA CUDA container from https://hub.docker.com/r/nvidia/cuda/
# Updated to CUDA 12.4.1 with cuDNN 9 (latest as of January 2025)
FROM nvidia/cuda:12.4.1-cudnn9-runtime-ubuntu22.04

# Install additional packages (consolidated for smaller image size)
RUN apt update && apt install -y \
    apt-utils curl wget vim git zsh sudo unzip \
    build-essential clang libicu-dev \
    python3-dev python3-pip fish \
    && rm -rf /var/lib/apt/lists/*


#Setup a user for inside the container
RUN useradd -ms /bin/zsh tduser
RUN echo "tduser:tduser" | chpasswd && adduser tduser sudo 
RUN echo "tduser ALL=(ALL) NOPASSWD: ALL" >> /etc/sudoers
USER tduser
WORKDIR /home/tduser

# Define environment variable
ENV SHELL=/bin/fish
ENV export SHELL
ENV export LC_ALL=C
ENV PATH="/home/tduser/.local/bin:${PATH}"


CMD ["fish"]





